    ## comments come from the programming language##
    ## '[a;b;]' combination comes from the programming language##
## '@x {a;b;}' void functions come from the programming language##
## '&var = 2' constant variables come from the programming language##
    ## 'a,(&var + (2-4));' basic arithmetic w/o recursion comes from the programming language##
    ## 'repeat(&x){a;}' basic control flow comes from the programming language##
##(2)
## 'set(label); goto(label);' goto support does NOT come from the programming language##

## '[@fn1; @fn2;]' function combination does NOT come from the programming language##
## 'if(&x == &y)' logical control flow does NOT come from the programming language##
## 'get $file.s3wcil$' file importing via functions does NOT come from the programming language##

## 7 (out of 13, remaining 6) system commands remain unaffected by the programming language##

&var = 2;
&var2 = (3 - &var);

@func {
    a, 2, 3;
    b;
    c;
}

@func_w_args &arg1 &arg2 {
    a, &arg1;
    c;
    b, &var, (&arg2 + &var);
}

@main {
    a;
    b, (&var + 3), &var2;
    @func;
    @func_w_args, 6, 7;
    repeat(5) {
        c, &var2;
    }
    [c; b, 3, 4; c;]
}
